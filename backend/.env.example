# Backend runtime profile
SPRING_PROFILES_ACTIVE=dev

# Required JWT signing secret (generate with: openssl rand -base64 64)
JWT_SECRET=replace-with-a-strong-base64-secret
JWT_EXPIRATION_MS=86400000

# Local PostgreSQL settings
DB_URL=jdbc:postgresql://localhost:5432/medicaltracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional backend settings
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
APP_IMAGE_STORAGE_PATH=./var/medical-images
APP_IMAGE_MAX_SIZE_MB=10

# Optional first-admin bootstrap (use once, then disable)
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@clinic.local
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
